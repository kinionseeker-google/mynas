#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled port data_dir files_dir require_mount proxy_ports min_free disks

	config_load mynas
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	config_get port main port 8580
	config_get data_dir main data_dir /etc/mynas
	config_get files_dir main files_dir /mnt/mynas
	config_get_bool require_mount main require_mount 0
	config_get proxy_ports main proxy_ports 18600-18649
	config_get min_free main min_free 64
	config_get disks main disks auto

	mkdir -p "$data_dir" || return 1

	procd_open_instance
	# run.sh waits for the disk when require_mount is set, then execs mynas.
	procd_set_param command /bin/sh /usr/share/mynas/run.sh "$require_mount" "$files_dir" \
		-addr ":$port" -data "$data_dir" -proxy-ports "$proxy_ports" -min-free "$min_free" -disks "$disks" \
		-files-hook /usr/share/mynas/set-files.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /var/run/mynas.state
}

service_triggers() {
	procd_add_reload_trigger mynas
}
